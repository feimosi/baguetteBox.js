{
    "name": "baguettebox.js",
    "version": "1.13.0",
    "author": "feimosi",
    "description": "Simple and easy to use lightbox script written in pure JavaScript",
    "license": "MIT",
    "homepage": "https://github.com/feimosi/baguetteBox.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/feimosi/baguetteBox.js.git"
    },
    "bugs": {
        "url": "https://github.com/feimosi/baguetteBox.js/issues"
    },
    "main": "dist/baguetteBox.min.js",
    "style": "dist/baguetteBox.min.css",
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "start": "gulp",
        "lint": "eslint gulpfile.js playwright.config.js eslint.config.js tests/**/*.js",
        "typecheck": "tsc --project tsconfig.json",
        "test": "npm run build && npm run lint && npm run typecheck",
        "test:ui": "playwright test",
        "test:ui:update": "playwright test --update-snapshots",
        "build": "gulp build",
        "release": "gulp release",
        "patch": "gulp patch"
    },
    "resolutions": {
        "natives": "1.1.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@playwright/test": "~1.58.2",
        "browser-sync": "^2.26.7",
        "eslint": "^9.39.1",
        "globals": "^16.4.0",
        "gulp": "~4.0.2",
        "gulp-autoprefixer": "^6.1.0",
        "gulp-bump": "^3.1.3",
        "gulp-clean-css": "~4.3.0",
        "gulp-concat": "^2.6.1",
        "gulp-gh-pages": "~0.5.4",
        "gulp-if": "^2.0.2",
        "gulp-inject-version": "^1.0.1",
        "gulp-load-plugins": "^2.0.2",
        "gulp-rimraf": "~0.2.2",
        "gulp-uglify": "^3.0.2",
        "gulp-usemin": "~0.3.30",
        "jsonfile": "^6.0.1",
        "typescript": "~5.9.3"
    },
    "overrides": {
        "graceful-fs": "^4.2.11",
        "gift": "0.10.2"
    },
    "keywords": [
        "lightbox",
        "gallery",
        "modal",
        "responsive"
    ]
}
